      {"name": "notional", "dtype": "float", "minimum": 0.0}
    ],
    "output_schema": [
      {"name": "npv", "dtype": "float"},
      {"name": "vega", "dtype": "float"},
      {"name": "delta", "dtype": "float"}
    ]
  },

  "constraints": {
    "operating_boundary": {
      "assumptions": [
        {"key": "expiry_years", "minimum": 0.02, "maximum": 30.0},
        {"key": "strike", "minimum": -0.02, "maximum": 0.15}
      ],
      "guarantees": [
        {"key": "repricing_error_bp", "maximum": 0.5}
      ]
    },
    "on_boundary_violation": "reject",
