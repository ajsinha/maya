  "io_contract": {
    "input_schema": [
      {"name": "expiry_years", "dtype": "float", "minimum": 0.02, "maximum": 30.0},
      {"name": "tenor_years", "dtype": "float", "minimum": 0.5, "maximum": 30.0},
