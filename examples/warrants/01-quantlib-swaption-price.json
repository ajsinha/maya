  "data": {
    "inputs": [
      {
        "name": "trades",
        "binding": "request",
        "description": "Swaption terms: expiry, tenor, strike, notional, payer/receiver"
      },
      {
        "name": "market",
        "binding": "market_data",
        "curve_set": "EOD.EUR.2026-01-01",
        "as_of": 1767225600.0,
        "description": "The curve set is pinned. A price is only reproducible against the curves it was struck from."
      }
