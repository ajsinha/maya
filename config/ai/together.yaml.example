# A MAYA model profile, one per file (copy to together.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: together
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "Together AI (OpenAI-compatible)"
options:
  base_url: "https://api.together.xyz/v1"
  api_key_env: "TOGETHER_API_KEY"
