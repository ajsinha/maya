# A MAYA model profile, one per file (copy to lmstudio.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: lmstudio
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "LM Studio (local) (OpenAI-compatible)"
options:
  base_url: "http://localhost:1234/v1"
