# A MAYA model profile, one per file (copy to groq.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: groq
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "Groq (OpenAI-compatible)"
options:
  base_url: "https://api.groq.com/openai/v1"
  api_key_env: "GROQ_API_KEY"
