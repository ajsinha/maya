# A MAYA model profile, one per file (copy to xai.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: xai
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "xAI (OpenAI-compatible)"
options:
  base_url: "https://api.x.ai/v1"
  api_key_env: "XAI_API_KEY"
