# A MAYA model profile, one per file (copy to deepseek.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: deepseek
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "DeepSeek (OpenAI-compatible)"
options:
  base_url: "https://api.deepseek.com/v1"
  api_key_env: "DEEPSEEK_API_KEY"
