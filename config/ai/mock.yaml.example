# A MAYA model profile, one per file (copy to mock.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: mock
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "Rule-driven answers for tutorials and tests: offline, free, repeatable"
options:
  rules_file: "config/ai/mock.rules.yaml"
