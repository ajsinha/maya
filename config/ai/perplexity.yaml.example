# A MAYA model profile, one per file (copy to perplexity.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: perplexity
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "Perplexity (OpenAI-compatible)"
options:
  base_url: "https://api.perplexity.ai"
  api_key_env: "PERPLEXITY_API_KEY"
