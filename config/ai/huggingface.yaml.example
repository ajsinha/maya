# A MAYA model profile, one per file (copy to huggingface.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: huggingface
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "Hugging Face (OpenAI-compatible)"
options:
  base_url: "https://router.huggingface.co/v1"
  api_key_env: "HF_TOKEN"
