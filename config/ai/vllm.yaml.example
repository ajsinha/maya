# A MAYA model profile, one per file (copy to vllm.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: vllm
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "vLLM (self-hosted) (OpenAI-compatible)"
options:
  base_url: "http://localhost:8000/v1"
