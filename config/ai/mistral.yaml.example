# A MAYA model profile, one per file (copy to mistral.yaml to switch it on).
# The key is read from the environment variable named in options.api_key_env, never from here.

provider: mistral
model: ""  # the model to ask: see the provider's list
max_tokens: 2048
description: "Mistral (OpenAI-compatible)"
options:
  base_url: "https://api.mistral.ai/v1"
  api_key_env: "MISTRAL_API_KEY"
