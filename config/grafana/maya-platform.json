    {
      "id": 24,
      "type": "stat",
      "title": "Webhook backlog",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 37
      },
