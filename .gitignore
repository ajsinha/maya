# ---------------------------------------------------------------- runtime data
# Nothing under data/ is committed. It is runtime state: the control-plane
# database, the content-addressed artifact store, and the Delta Lake root.
# Artifacts in particular may be proprietary models or contain personal data,
# and Delta tables are large and machine-generated.
/data/
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Delta Lake internals, wherever a table is rooted
_delta_log/
*.parquet
*.crc

# ------------------------------------------------------------------- secrets
# Local configuration overlays hold values a machine needs but that must not be
# committed. The tracked application.yaml deliberately carries no secrets.
config/*.local.yaml
config/*.local.yml
config/*.local.json
.env
.env.*
!.env.example
*.pem
*.key
!**/*.public.key
credentials.json
secrets.yaml

# -------------------------------------------------------------------- python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# ---------------------------------------------------------- virtual environments
.venv/
venv/
ENV/
env/

# `.python-version` used to be here, grouped with the environments as a
# developer-local pyenv marker. It is tracked now, because it is not a local
# preference: it names the interpreter the linter's `target-version` and CI's
# `PYTHON_VERSION` are set to agree with, and both `uv` and `pyenv` read it
# without being told. Ignored, it was a fourth opinion about the Python version
# that only some machines held.

# ---------------------------------------------------------------- test & tools
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# ---------------------------------------------------------------------- latex
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.bbl
*.blg
*.lof
*.lot
*.log

# ---------------------------------------------------------------------- logs
logs/
*.log
!docs/**/*.log

# --------------------------------------------------------------- editors / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------ scratch
scratch/
tmp/
*.tmp
*.bak
*.orig

# Agent worktrees and session state. Never part of the repository.
.claude/

# Workbooks generated from the CSVs at deck build time. The CSVs are
# the source; these are derived and are embedded into the pptx.
# Workbooks generated from the published series at deck build time. The CSVs in
# docs/examples/ are the source; these are derived and embedded into the pptx.
docs/examples/*.xlsx

# Only a development aid: `npm install --no-save jsdom` gives
# tests/test_ui_tables.py a real DOM to run the table enhancer in.
# Nothing at runtime depends on it, and the suite skips without it.
node_modules/
package-lock.json

# Coverage, produced by the hygiene gate and combined in CI.
.coverage
.coverage.*
htmlcov/
sbom.json

# Files the tutorials tell a reader to create, and the pack they download.
# `content/tutorials/` is run against a live instance as part of reviewing it,
# and the run leaves these in the working directory.
*.zip
sb-pd-mdd.md
sb_pd_2026_v2_dictionary.md
ebitda.md
fit-note.md
q2.csv
my-warrant.json

# The soak run's scratch server and database. The JOURNAL is committed
# (docs/soak/); the working state it was produced from is not.
.soak/
