# ---------------------------------------------------------------- runtime data
# Nothing under data/ is committed. It is runtime state: the control-plane
# database, the content-addressed artifact store, and the Delta Lake root.
# Artifacts in particular may be proprietary models or contain personal data,
# and Delta tables are large and machine-generated.
/data/
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Delta Lake internals, wherever a table is rooted
_delta_log/
*.parquet
*.crc

# ------------------------------------------------------------------- secrets
# Local configuration overlays hold values a machine needs but that must not be
# committed. The tracked application.yaml deliberately carries no secrets.
config/*.local.yaml
config/*.local.yml
config/*.local.json
.env
.env.*
!.env.example
*.pem
*.key
!**/*.public.key
credentials.json
secrets.yaml

# -------------------------------------------------------------------- python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# ---------------------------------------------------------- virtual environments
.venv/
venv/
ENV/
env/
.python-version

# ---------------------------------------------------------------- test & tools
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# ---------------------------------------------------------------------- latex
*.aux
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.bbl
*.blg
*.lof
*.lot
*.log

# ---------------------------------------------------------------------- logs
logs/
*.log
!docs/**/*.log

# --------------------------------------------------------------- editors / OS
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------ scratch
scratch/
tmp/
*.tmp
*.bak
*.orig

# Agent worktrees and session state. Never part of the repository.
.claude/
