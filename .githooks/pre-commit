#!/usr/bin/env python3
"""Run the fast static gates before every commit (plan §7). Python, so it runs everywhere.

The gates import MAYA, so they run with the project's virtualenv when there is one
(.venv on POSIX or Windows), falling back to the interpreter that runs this hook.
"""
import subprocess
import sys
from pathlib import Path

root = Path(__file__).resolve().parents[1]
candidates = [root / ".venv" / "bin" / "python", root / ".venv" / "Scripts" / "python.exe"]
python = next((str(p) for p in candidates if p.exists()), sys.executable)
sys.exit(subprocess.call([python, str(root / "tools" / "ci" / "gates.py")], cwd=root))
